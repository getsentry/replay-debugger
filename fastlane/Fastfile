# Fastfile

default_platform(:mac)

platform :mac do

  desc "Import signing certificates and provisioning profiles to keychain"
  lane :prepare_signing do
    setup_ci if is_ci

    sync_code_signing(
      type: "developer_id",
      readonly: true,
      app_identifier: [CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)],
    )
  end

  desc "Build the release version of the app"
  lane :build_release do
    gym(
      project: "SentryReplayDebugger.xcodeproj",
      scheme: "SentryReplayDebugger",
      configuration: "Release",
      destination: "generic/platform=macOS",
      skip_package_pkg: true,
      skip_archive: true,
      xcargs: {
        'CODE_SIGN_STYLE' => 'Manual',
        'CODE_SIGN_IDENTITY' => 'Developer ID Application',
        'PRODUCT_BUNDLE_IDENTIFIER' => CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier),
        'DEVELOPMENT_TEAM' => CredentialsManager::AppfileConfig.try_fetch_value(:team_id),
        'PROVISIONING_PROFILE_SPECIFIER' => "match Direct #{CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)} macos"
      }
    )
  end

    desc "Notarize app"
    lane :notarize_app do |options|
      zip_path = options[:zip_path] || "SentryReplayDebugger.zip"
      api_key_path = "/tmp/AuthKey.p8"
      File.write(api_key_path, ENV["APP_STORE_CONNECT_KEY"])

      sh(
        "xcrun notarytool submit #{zip_path} " \
        "--key #{api_key_path} " \
        "--key-id #{ENV['APP_STORE_CONNECT_KEY_ID']} " \
        "--issuer #{ENV['APP_STORE_CONNECT_ISSUER_ID']} " \
        "--wait"
      )

      # Clean up temporary key file
      File.delete(api_key_path) if File.exist?(api_key_path)
    end

end
